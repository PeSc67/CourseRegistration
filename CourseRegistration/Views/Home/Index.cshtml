@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer

<style>
    .flex-container {
        display: flex;
        justify-content: space-around;
    }

    .flex-container > div {
            background-color: #ffffff;
            width: 510px;
            margin: 10px;
            text-align: center;
            border: 1px solid gray;
            border-radius: 20px;
            box-shadow: 15px 15px 10px lightgray;
